{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptaorg.com/ai-system/report-standards/report-dataset.schema.json",
  "title": "PTA municipality and school audit source dataset v1.0.0",
  "description": "A fact-and-source ledger. Legal conclusions, calculated percentages, and published claims live outside the raw axis observations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportId",
    "asOf",
    "municipality",
    "scope",
    "sources",
    "municipalDocuments",
    "schools",
    "narrativeClaims",
    "legalReviews",
    "publication"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "reportId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "asOf": {
      "type": "string",
      "format": "date"
    },
    "municipality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "prefecture",
        "lat",
        "long",
        "coordinateSourceId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "prefecture": {
          "type": "string",
          "minLength": 1
        },
        "lat": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90
        },
        "long": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180
        },
        "coordinateSourceId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalPublicSchools",
        "populationSourceId",
        "populationSchoolIds",
        "sampling",
        "scopeNote",
        "schoolTypes",
        "targetYears"
      ],
      "properties": {
        "totalPublicSchools": {
          "type": "integer",
          "minimum": 1
        },
        "populationSourceId": {
          "type": "string",
          "minLength": 1
        },
        "populationSchoolIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]+$"
          },
          "description": "Official complete school ID roster; census schools must match this set exactly"
        },
        "sampling": {
          "enum": [
            "census",
            "selected"
          ]
        },
        "scopeNote": {
          "type": "string",
          "minLength": 1
        },
        "schoolTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "targetYears": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "issuer",
          "kind",
          "documentDate",
          "targetYear",
          "url",
          "filePath",
          "verification",
          "verifiedAt",
          "publicationLinkChecked",
          "containsPersonalData",
          "redactionChecked"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "issuer": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "primary",
              "secondary",
              "internal"
            ]
          },
          "documentDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "targetYear": {
            "type": "string",
            "pattern": "^[0-9]{4}$"
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "filePath": {
            "type": [
              "string",
              "null"
            ]
          },
          "verification": {
            "enum": [
              "direct_checked",
              "metadata_only",
              "unavailable"
            ]
          },
          "verifiedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "publicationLinkChecked": {
            "type": "boolean"
          },
          "containsPersonalData": {
            "type": "boolean"
          },
          "redactionChecked": {
            "type": "boolean"
          }
        }
      }
    },
    "municipalDocuments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceId",
          "category",
