{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptaorg.com/schema/document-existence-1.1.0.json",
  "title": "PTA関係書類 存否台帳 v1.1.0",
  "description": "12評価軸（report-dataset.schema.json）とは別の、証拠文書の提出・保有・不存在決定の記録。書類が開示資料になかったことを理由に12軸の confirmed_no を付けてはならない。",
  "type": "object",
  "required": [
    "title",
    "version",
    "reviewDate",
    "scope",
    "relationToAxes",
    "source",
    "statusDefinitions",
    "documentTypes",
    "schools"
  ],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "reviewDate": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "string",
      "minLength": 20
    },
    "relationToAxes": {
      "type": "string",
      "minLength": 20
    },
    "source": {
      "type": "object",
      "required": [
        "title",
        "date",
        "totalDisclosedDocuments",
        "totalDisclosedPages",
        "disclosedSchools"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "note": {
          "type": "string"
        },
        "totalDisclosedDocuments": {
          "type": "integer",
          "minimum": 0
        },
        "totalDisclosedPages": {
          "type": "integer",
          "minimum": 0
        },
        "disclosedSchools": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "statusDefinitions": {
      "type": "object",
      "description": "下の status enum の各値に、その値を使ってよい条件を日本語で定義する。6値すべてを定義すること。",
      "required": [
        "present_as_standalone_document",
        "present_as_provision_only",
        "internal_rule_only",
        "not_found_in_disclosure",
        "not_disclosed",
        "formally_determined_nonexistent"
      ],
      "additionalProperties": {
        "type": "string",
        "minLength": 10
      }
    },
    "documentTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "schools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "documents"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "documents": {
            "type": "object",
            "description": "キーは documentTypes の id。全 documentType を漏れなく置く。",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": [
                "documentType",
                "year",
                "holder",
                "submitted",
                "status",
                "evidence",
                "observation",
                "checkedAt"
              ],
              "additionalProperties": false,
              "properties": {
                "documentType": {
                  "type": "string"
                },
                "year": {
                  "type": "string",
                  "pattern": "^\\d{4}$"
                },
                "requested": {
                  "type": [
                    "boolean",
                    "null"
                  ],
                  "description": "情報公開請求の対象に含めたか。未開示校は null。"
                },
                "holder": {
                  "type": "string",
                  "enum": [
                    "school",
                    "pta",
                    "board_of_education",
                    "school_or_pta",
                    "unknown"
                  ],
                  "description": "保有主体。行政の不存在決定は保有機関を特定したうえでなければ記録しない。"
                },
                "submitted": {
                  "type": "boolean",
                  "description": "当該文書が開示資料として提出されたか。status が present_* または internal_rule_only のとき true。"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "present_as_standalone_document",
                    "present_as_provision_only",
                    "internal_rule_only",
                    "not_found_in_disclosure",
                    "not_disclosed",
                    "formally_determined_nonexistent"
                  ]
                },
                "evidence": {
                  "type": "array",
                  "description": "証拠の所在。ファイルパスまたは出典IDと頁位置。status が present_* または internal_rule_only のときは1件以上。",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "observation": {
                  "type": "string",
                  "description": "原本から読み取れる事実。近接するが該当しない文書がある場合はその旨を書く。"
                },
                "counterEvidence": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "存在を主張する側が示した文書名・作成日・保有部署・適用年度・該当箇所。"
                },
                "formalDetermination": {
                  "type": "object",
                  "description": "status が formally_determined_nonexistent のときのみ。",
                  "required": [
                    "decisionDocument",
                    "decisionDate",
                    "holdingAuthority",
                    "targetYear"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "decisionDocument": {
                      "type": "string"
                    },
                    "decisionDate": {
                      "type": "string",
                      "format": "date"
                    },
                    "holdingAuthority": {
                      "type": "string"
                    },
                    "targetYear": {
                      "type": "string"
                    }
                  }
                },
                "checkedAt": {
                  "type": "string",
                  "format": "date"
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "formally_determined_nonexistent"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "formalDetermination"
                    ]
                  }
                },
                {
                  "if": {
                    "properties": {
                      "status": {
                        "enum": [
                          "present_as_standalone_document",
                          "present_as_provision_only",
                          "internal_rule_only"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "evidence": {
                        "minItems": 1
                      },
                      "submitted": {
                        "const": true
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "not_disclosed"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "submitted": {
                        "const": false
                      },
                      "evidence": {
                        "maxItems": 0
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
